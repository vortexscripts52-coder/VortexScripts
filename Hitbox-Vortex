local headValue=12
local bodyValue=12
local visibility=0
local mode="both"
local enabled=false
local minimized=false
local original={}

local function getTorso(char)
    return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("LowerTorso")
end

-- 🔥 FIX: FUNCION QUE RESTAURA SI O SI A NORMAL
local function restorePlayer(plr)
    pcall(function()
        if not plr.Character then return end
        local char=plr.Character
        local head=char:FindFirstChild("Head")
        local torso=getTorso(char)
        
        if head and original[plr.Name.."_H_Size"] then
            head.Size=original[plr.Name.."_H_Size"]
            head.Transparency=original[plr.Name.."_H_Trans"] or 0
            head.Color=original[plr.Name.."_H_Color"] or Color3.fromRGB(255,255,255)
            head.Material=Enum.Material.SmoothPlastic
            head.CanCollide=true
            head.Massless=false
        elseif head then
            -- Si no hay original guardado, forzar tamaño normal de Roblox
            head.Size=Vector3.new(2,1,1)
            head.Transparency=0
            head.Color=Color3.fromRGB(255,255,255)
            head.Material=Enum.Material.SmoothPlastic
        end
        
        if torso and original[plr.Name.."_T_Size"] then
            torso.Size=original[plr.Name.."_T_Size"]
            torso.Transparency=original[plr.Name.."_T_Trans"] or 0
            torso.Color=original[plr.Name.."_T_Color"] or Color3.fromRGB(255,255,255)
            torso.Material=Enum.Material.SmoothPlastic
            torso.CanCollide=true
            torso.Massless=false
        elseif torso then
            torso.Size=Vector3.new(2,2,1)
            torso.Transparency=0
            torso.Color=Color3.fromRGB(255,255,255)
            torso.Material=Enum.Material.SmoothPlastic
        end
    end)
end

local function restoreAll()
    for _,plr in pairs(Players:GetPlayers()) do
        if plr~=Player then
            restorePlayer(plr)
        end
    end
end

local function apply()
    for _,plr in pairs(Players:GetPlayers()) do
        if plr~=Player and plr.Character then
            local char=plr.Character
            local head=char:FindFirstChild("Head")
            local torso=getTorso(char)
            
            if head and (mode=="both" or mode=="head") then
                if not original[plr.Name.."_H_Size"] then 
                    original[plr.Name.."_H_Size"]=head.Size
                    original[plr.Name.."_H_Trans"]=head.Transparency
                    original[plr.Name.."_H_Color"]=head.Color
                end
                pcall(function()
                    head.Size=Vector3.new(headValue,headValue,headValue)
                    head.CanCollide=false
                    head.Massless=true
                    if visibility==0 then
                        head.Transparency=1
                    else
                        head.Transparency= 1 - (visibility/100)
                        head.Color=Color3.fromRGB(255,0,0)
                        head.Material=Enum.Material.ForceField
                    end
                end)
            end
            
            if torso and (mode=="both" or mode=="torso") then
                if not original[plr.Name.."_T_Size"] then 
                    original[plr.Name.."_T_Size"]=torso.Size
                    original[plr.Name.."_T_Trans"]=torso.Transparency
                    original[plr.Name.."_T_Color"]=torso.Color
                end
                pcall(function()
                    torso.Size=Vector3.new(bodyValue,bodyValue,bodyValue)
                    torso.CanCollide=false
                    torso.Massless=true
                    if visibility==0 then
                        torso.Transparency=1
                    else
                        torso.Transparency= 1 - (visibility/100)
                        torso.Color=Color3.fromRGB(255,0,0)
                        torso.Material=Enum.Material.ForceField
                    end
                end)
            end
        end
    end
end

local function updateVisibility(newVis)
    visibility=math.clamp(newVis,0,100)
    if visibility>0 and visibility<10 then visibility=10 end
    VisDisplay.Text=visibility.."%"
    if visibility==0 then
        VisLabel.Text="🔴 VISIBILIDAD: 0% (INVISIBLE TOTAL)"
        VisLabel.TextColor3=Color3.fromRGB(80,255,120)
        VisDisplay.BackgroundColor3=Color3.fromRGB(20,60,20)
        InvisBtn.BackgroundColor3=Color3.fromRGB(0,120,60)
        LowBtn.BackgroundColor3=Color3.fromRGB(50,50,60)
        FullBtn.BackgroundColor3=Color3.fromRGB(50,50,60)
    elseif visibility<=30 then
        VisLabel.Text="🔴 VISIBILIDAD: "..visibility.."% (CASI INVISIBLE)"
        VisLabel.TextColor3=Color3.fromRGB(255,200,100)
        VisDisplay.BackgroundColor3=Color3.fromRGB(60,40,20)
        InvisBtn.BackgroundColor3=Color3.fromRGB(50,50,60)
        LowBtn.BackgroundColor3=Color3.fromRGB(120,80,0)
        FullBtn.BackgroundColor3=Color3.fromRGB(50,50,60)
    else
        VisLabel.Text="🔴 VISIBILIDAD: "..visibility.."% (ROJA VISIBLE)"
        VisLabel.TextColor3=Color3.fromRGB(255,80,80)
        VisDisplay.BackgroundColor3=Color3.fromRGB(60,20,20)
        InvisBtn.BackgroundColor3=Color3.fromRGB(50,50,60)
        LowBtn.BackgroundColor3=Color3.fromRGB(50,50,60)
        FullBtn.BackgroundColor3=Color3.fromRGB(120,20,20)
    end
    if enabled then apply() end
end

