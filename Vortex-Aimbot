local fps=0
local lastTick=tick()
local frames=0
local lastPingValue=0
local lastPingChange=tick()
local failedReads=0

task.spawn(function()
    while Gui.Parent do
        task.wait(0.5)
        local ping=0
        local ok=false
        pcall(function() local v=Stats.Network.ServerStatsItem["Data Ping"]:GetValue() if v and v>0 then ping=math.floor(v) ok=true end end)
        if not ok or ping==0 then pcall(function() local v2=Player:GetNetworkPing()*1000 if v2 and v2>0 then ping=math.floor(v2) ok=true end end) end
        if not ok or ping==0 then
            failedReads=failedReads+1
            if failedReads>=4 then PingOutsideLabel.Text="PING: SIN INTERNET" PingOutsideLabel.TextColor3=Color3.fromRGB(255,0,0) end
        else
            if ping==lastPingValue then
                if tick()-lastPingChange>4 then PingOutsideLabel.Text="PING: SIN INTERNET" PingOutsideLabel.TextColor3=Color3.fromRGB(255,0,0) end
            else
                lastPingValue=ping lastPingChange=tick() failedReads=0
                if ping>=999 then PingOutsideLabel.Text="PING: 999+ SIN INTERNET" PingOutsideLabel.TextColor3=Color3.fromRGB(255,0,0)
                elseif ping>=200 then PingOutsideLabel.Text="PING: "..ping.." LENTO" PingOutsideLabel.TextColor3=Color3.fromRGB(255,255,0)
                elseif ping>60 then PingOutsideLabel.Text="PING: "..ping.." NORMAL" PingOutsideLabel.TextColor3=Color3.fromRGB(255,255,255)
                else PingOutsideLabel.Text="PING: "..ping.." RAPIDO" PingOutsideLabel.TextColor3=Color3.fromRGB(0,255,0) end
            end
        end
        if fps>=40 then
            FpsOutsideLabel.Text="FPS: "..fps
            FpsOutsideLabel.TextColor3=Color3.fromRGB(0,255,0)
        elseif fps>=25 then
            FpsOutsideLabel.Text="FPS: "..fps
            FpsOutsideLabel.TextColor3=Color3.fromRGB(255,255,0)
        else
            FpsOutsideLabel.Text="FPS: "..fps
            FpsOutsideLabel.TextColor3=Color3.fromRGB(255,0,0)
        end
    end
end)

RunService.RenderStepped:Connect(function() frames=frames+1 if tick()-lastTick>=1 then fps=frames frames=0 lastTick=tick() end end)

local function isVisible(targetPart, targetChar)
    local origin = Camera.CFrame.Position
    local direction = (targetPart.Position - origin)
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Blacklist
    rayParams.FilterDescendantsInstances = {Player.Character, targetChar}
    rayParams.IgnoreWater = true
    local raycast = workspace:Raycast(origin, direction, rayParams)
    if raycast then return false else return true end
end

local function getTarget()
    local myChar=Player.Character
    if not myChar then return nil end
    local hrpMy=myChar:FindFirstChild("HumanoidRootPart")
    if not hrpMy then return nil end
    local closest=nil
    local dMin=9999
    for _,plr in pairs(Players:GetPlayers()) do
        if plr~=Player and plr.Character then
            if Player.Team and plr.Team and Player.Team == plr.Team then
                continue
            end
            local hum=plr.Character:FindFirstChildOfClass("Humanoid")
            local hrp=plr.Character:FindFirstChild("HumanoidRootPart")
            local head = plr.Character:FindFirstChild(AimPart) or hrp
            if hum and hrp and head and hum.Health>0 then
                local dist3D=(hrp.Position-hrpMy.Position).Magnitude
                if dist3D<=MaxDist then
                    local sp,on=Camera:WorldToViewportPoint(hrp.Position)
                    if on then
                        local fovC=Vector2.new(Camera.ViewportSize.X/2+FovOffsetX, Camera.ViewportSize.Y/2+FovOffsetY)
                        local sDist=(Vector2.new(sp.X,sp.Y)-fovC).Magnitude
                        if sDist<=FOV then
                            if isVisible(head, plr.Character) then
                                if sDist<dMin then dMin=sDist closest=plr end
                            end
                        end
                    end
                end
            end
        end
    end
    return closest
end

RunService:BindToRenderStep("Calib",Enum.RenderPriority.Camera.Value+1,function()
    if not Enabled or Percent==0 then return end
    local t=getTarget()
    if t and t.Character then
        local p=t.Character:FindFirstChild(AimPart) or t.Character:FindFirstChild("HumanoidRootPart")
        if p then
            local s=(Percent/100)*0.9
            local tp=p.Position+Vector3.new(0,HeightOffset,0)+p.Velocity*0.18
            Camera.CFrame=Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position,tp),s)
        end
    end
end)
update()
